# Server only. Copy to .env.local; keep every secret out of VITE_ variables.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Video avatar modu (sağ alttaki sohbet kutusunun varsayılanı): sohbet, seslendirme ve konuşma tanıma
# yukarıdaki OPENAI_API_KEY ile çalışır. Sohbet modelini değiştirmek için yalnızca bu satırı düzenleyin.
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Ses adayları: viseme_analysis/voices/ (erkek tınılı: ash, echo, cedar, onyx, fable, alloy)
OPENAI_TTS_VOICE=ash
OPENAI_STT_MODEL=gpt-transcribe

# Synthesia Studio > Developers > API keys > Interactive Avatars (write)
SYNTHESIA_API_KEY=
# Studio > Avatars > eligible synthetic avatar > Copy Interactive ID
SYNTHESIA_AVATAR_DEFAULT_ID=
# Optional: only after our character has a usable Synthesia Interactive ID.
SYNTHESIA_AVATAR_CUSTOM_ID=

# All three values must belong to the same LiveKit Cloud project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini 3.8 Live Avatar (Google Cloud ADC, not an AI Studio API key).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_AVATAR_NAME=Ben
# Optional credential file path; otherwise use gcloud auth application-default login.
GOOGLE_APPLICATION_CREDENTIALS=
