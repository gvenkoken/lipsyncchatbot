{
  "name": "lipsysncdemo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5176 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/browser-qa.mjs && node scripts/synthesia-browser-qa.mjs && node scripts/gemini-browser-qa.mjs",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-mouths.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-eyes.ps1"
  },
  "dependencies": {
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-openai": "1.9.5",
    "@livekit/agents-plugin-synthesia": "1.9.5",
    "@livekit/rtc-node": "1.2.2",
    "google-auth-library": "11.3.4",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.3",
    "lucide-react": "0.546.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@livekit/protocol": "1.53.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.8.3",
    "vite": "8.0.16"
  }
}
